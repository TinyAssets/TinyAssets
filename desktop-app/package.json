{
  "name": "tinyassets-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "TinyAssets desktop app — a thin Electron shell over the live TinyAssets web app (https://tinyassets.io/app), mirroring the Android Capacitor shell so all surfaces share one synced universe.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis zip",
    "dist:winportable": "electron-builder --win zip"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.tinyassets.app",
    "productName": "TinyAssets",
    "protocols": [
      {
        "name": "TinyAssets approval return",
        "schemes": [
          "tinyassets-desktop"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "config.js",
      "package.json"
    ],
    "win": {
      "icon": "../assets/brand/tinyassets-app.ico",
      "artifactName": "TinyAssetsChat-${version}-${arch}-win.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "TinyAssetsChatSetup-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "../assets/brand/tinyassets-app.icns",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "../assets/icon.png",
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
