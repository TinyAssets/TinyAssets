{
  "schema_version": 2,
  "name": "codex",
  "description": "OpenAI Codex CLI package",
  "external_agents": [
    {
      "name": "codex",
      "description": "OpenAI Codex CLI",
      "family": "openai",
      "install": {"npm": "@openai/codex", "version": "0.160.0", "bin": "codex"},
      "auth": {
        "service": "codex",
        "home_env": "CODEX_HOME",
        "home_dir": "codex",
        "files": ["auth.json"],
        "writeback": ["auth.json"],
        "env_from_file": {}
      },
      "catalogue": {
        "transport": "jsonrpc",
        "argv": ["app-server"],
        "initialize": {
          "method": "initialize",
          "params": {"clientInfo": {"name": "tinyassets", "version": "1"}},
          "notification": "initialized"
        },
        "list": {
          "method": "model/list",
          "params": {"limit": 100, "includeHidden": true},
          "items": "/data",
          "cursor": "/nextCursor",
          "cursor_param": "cursor"
        },
        "row": {
          "model": "/model",
          "default": "/isDefault",
          "hidden": "/hidden",
          "modalities": "/inputModalities",
          "effort_levels": "/supportedReasoningEfforts",
          "effort_level": "/reasoningEffort"
        }
      },
      "job": {
        "transport": "jsonrpc",
        "argv": [
          "app-server", "--disable", "shell_tool", "--disable", "unified_exec",
          "--disable", "apps", "--disable", "plugins", "--disable", "remote_plugin",
          "--disable", "multi_agent", "--disable", "sleep_tool", "--disable", "goals",
          "--disable", "image_generation", "--disable", "view_image",
          "--disable", "skill_search", "-c", "web_search=\"disabled\"",
          "-c", "tools.experimental_request_user_input={enabled=false}",
          "-c", "include_permissions_instructions=false",
          "-c", "include_environment_context=false",
          "-c", "include_apps_instructions=false",
          "-c", "include_collaboration_mode_instructions=false",
          "-c", "skills.include_instructions=false",
          "-c", "project_doc_max_bytes=0"
        ],
        "initialize": {"method": "initialize", "params": {
          "clientInfo": {"name": "tinyassets", "version": "1"},
          "capabilities": {"experimentalApi": true}
        }, "notification": "initialized"},
        "catalogue_rewrite": {
          "source": "bundled-models.json", "setting": "model_catalog_json",
          "model_field": "slug", "clear_fields": {
            "multi_agent_version": null, "apply_patch_tool_type": null,
            "experimental_supported_tools": [], "supports_search_tool": false
          }, "remove_fields": ["tool_mode"]
        },
        "start": {
          "method": "thread/start",
          "params": {"model": "{model}", "cwd": "{workdir}", "ephemeral": false,
                     "approvalPolicy": "never", "sandbox": "danger-full-access",
                     "baseInstructions": "{system}"}
        },
        "resume": {"method": "thread/resume", "params": {
          "threadId": "{session}", "baseInstructions": "{system}"}},
        "input": {
          "method": "turn/start",
          "params": {"threadId": "{session}", "input": "{input}", "effort": "{effort}"}
        },
        "session_handle": "/thread/id",
        "configured_model": "/thread/model",
        "tools": {"mode": "dynamic_rpc", "define_at": "/dynamicTools",
                  "call_method": "item/tool/call"},
        "events": {
          "text_delta": {"method": "item/agentMessage/delta", "text": "/delta"},
          "item_done": {"method": "item/completed", "type": "/item/type",
                        "text": "/item/text", "agent_type": "agentMessage"},
          "usage": {"method": "thread/tokenUsage/updated",
                    "input": "/tokenUsage/last/inputTokens",
                    "output": "/tokenUsage/last/outputTokens",
                    "reasoning_output": "/tokenUsage/last/reasoningOutputTokens"},
          "model": {"method": "turn/started", "value": "/turn/model"},
          "done": {"method": "turn/completed", "status": "/turn/status",
                   "items": "/turn/items", "item_type": "/type",
                   "item_text": "/text", "agent_type": "agentMessage",
                   "auth_error": "/turn/error/codexErrorInfo",
                   "auth_code": "unauthorized",
                   "success": "completed"}
        },
        "cancel": {"method": "turn/interrupt", "params": {"threadId": "{session}"},
                   "grace_s": 10}
      }
    }
  ]
}
