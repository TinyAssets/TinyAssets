[Unit]
Description=Prepare TinyAssets box store device
DefaultDependencies=no
After=local-fs-pre.target
Before=var-lib-boxhostd-owners.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/tinyassets/boxhostd/box-store-device.sh
ExecStop=/opt/tinyassets/boxhostd/box-store-device-stop.sh

[Install]
WantedBy=multi-user.target
