# TinyAssets daemon systemd unit — wraps docker compose up.
#
# Self-host migration Row D per
# docs/exec-plans/active/2026-04-20-selfhost-uptime-migration.md.
#
# Install:
#   sudo cp deploy/tinyassets-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tinyassets-daemon
#
# State:
#   sudo systemctl status tinyassets-daemon
#   sudo journalctl -u tinyassets-daemon -f
#
# Restart semantics: `Restart=always` — if docker compose exits for any
# reason (crash, OOM, compose stop), systemd re-starts it. Row L adds
# a watchdog unit on top that probes the MCP endpoint and issues
# `systemctl restart tinyassets-daemon` on hung-but-not-crashed states.
#
# Runs as the unprivileged `tinyassets` user (uid 1001 per Dockerfile
# non-root setup). Assumes `tinyassets` user is in the `docker` group —
# bootstrap script handles that.

[Unit]
Description=TinyAssets MCP daemon + cloudflared tunnel sidecar
Documentation=https://github.com/TinyAssets/TinyAssets/blob/main/deploy/HETZNER-DEPLOY.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

# Type=oneshot + RemainAfterExit=yes + `docker compose up -d` (2026-08-21 P0 fix).
# The old Type=simple + foreground `docker compose up` made systemd watch the
# compose CLI process; when that process exited during a deploy's down/up (a
# transient, aggravated by the watchdog racing a `systemctl restart`), Restart=always
# hot-looped it until StartLimitBurst tripped and systemd gave up — leaving the whole
# stack (daemon + tunnel) STOPPED and prod 502. `up -d` returns cleanly after the
# stack is healthy; RemainAfterExit keeps the unit "active"; docker's own
# restart policy (compose.yml) handles container-level crashes.
[Service]
Type=oneshot
RemainAfterExit=yes
User=tinyassets
Group=tinyassets
WorkingDirectory=/opt/tinyassets
# NO EnvironmentFile= here (2026-08-21 root cause): /etc/tinyassets/env is the
# CONTAINER's env and carries HOME=/app. EnvironmentFile= always overrides
# Environment= (systemd.exec), whatever the order, so the docker CLI ran with
# HOME=/app, could not read /app/.docker/config.json, skipped plugin discovery,
# and `docker compose` died with "unknown flag: --env-file" (journal evidence).
# Compose receives that file through --env-file; the unit only needs the HOST
# account's HOME so the CLI finds /usr/libexec/docker/cli-plugins.
Environment=HOME=/opt/tinyassets

# Pre-check: the compose env_file lives at /etc/tinyassets/env and must be
# readable by this unit's User=tinyassets. If not, docker compose fails
# silently and cloudflared never starts — the 2026-04-21 P0 class.
# Emit a canonical `ENV-UNREADABLE` marker to stderr (→ journald) so
# p0-outage-triage.yml can grep journalctl and self-repair without an
# SSH shell. ExecStartPre= with a leading `-` would tolerate failure;
# we do NOT use `-` so systemd refuses to start with the marker logged.
ExecStartPre=/bin/sh -c 'test -r /etc/tinyassets/env || { echo "ENV-UNREADABLE: /etc/tinyassets/env not readable by user tinyassets (uid $$(id -u))" >&2; ls -l /etc/tinyassets/env >&2 || true; exit 1; }'
# The daemon loads /etc/tinyassets/daemon.env, rendered from /etc/tinyassets/env
# minus the platform's own secrets (deploy/install-tinyassets-env.sh
# render-daemon-env, installed by every deploy as /usr/local/sbin/tinyassets-env).
# Every helper write re-renders it; a hand edit of the source
# does not, and starting on the stale copy would silently ignore that edit.
# Refuse instead, naming the fix. Containers already running are not stopped:
# this unit has no ExecStop.
ExecStartPre=/bin/sh -c 'test -r /etc/tinyassets/daemon.env || { echo "DAEMON-ENV-UNREADABLE: /etc/tinyassets/daemon.env missing or unreadable; run: sudo tinyassets-env render-daemon-env" >&2; exit 1; }; if [ /etc/tinyassets/env -nt /etc/tinyassets/daemon.env ]; then echo "DAEMON-ENV-STALE: /etc/tinyassets/env changed after daemon.env was rendered; run: sudo tinyassets-env render-daemon-env" >&2; exit 1; fi'
ExecStartPre=/bin/sh -c 'meta=$$(stat -c "%%U:%%G %%a" /etc/tinyassets/agent-interchange.env 2>/dev/null || true); test -r /etc/tinyassets/agent-interchange.env && [ "$$meta" = "root:tinyassets 640" ] || { echo "AGENT-INTERCHANGE-ENV-UNREADABLE: /etc/tinyassets/agent-interchange.env must be readable with root:tinyassets 640 (found $$meta)" >&2; ls -l /etc/tinyassets/agent-interchange.env >&2 || true; exit 1; }'
ExecStartPre=/bin/sh -c 'meta=$$(stat -c "%%U:%%G %%a" /etc/tinyassets/request-idempotency.env 2>/dev/null || true); test -r /etc/tinyassets/request-idempotency.env && [ "$$meta" = "root:tinyassets 640" ] || { echo "REQUEST-IDEMPOTENCY-ENV-UNREADABLE: /etc/tinyassets/request-idempotency.env must be readable with root:tinyassets 640 (found $$meta)" >&2; ls -l /etc/tinyassets/request-idempotency.env >&2 || true; exit 1; }'

# `up -d` starts the stack detached and returns once it is up + healthy (the
# tunnel depends_on the daemon's healthcheck), so systemd never watches a
# long-lived foreground CLI. The THREE production services are named
# explicitly: compose.yml also defines unprofiled worker services, and an
# unqualified `up -d` would start all of them on the host (Codex review).
#
# Deliberately NO ExecStop=: this is a bootstrap/converge unit, not the
# container lifetime. A `compose down` here meant every `systemctl restart`
# (watchdog, operator, env apply) tore down daemon + tunnel + logs together and
# a failed restart left production down. Stopping the unit leaves the
# containers to docker's restart policy; restarting it re-converges. The
# watchdog restarts the daemon CONTAINER, daemon-scoped (daemon-watchdog.sh).
# `--timeout 20` bounds the old daemon's drain on a unit-driven recreate, matching
# deploy_fail_safe.sh's MAX_DAEMON_STOP_GRACE_S. Without it, compose uses the
# container's create-time StopTimeout, which is 180s for anything a rollback
# recreated from a pre-2026-10-01 bundle.
ExecStart=/usr/bin/docker compose --env-file /etc/tinyassets/env -f /opt/tinyassets/compose.yml up -d --timeout 20 daemon cloudflared logs

# Restart posture. on-failure (NOT always — with RemainAfterExit, `always` would
# re-run a SUCCESSFUL oneshot). 10s delay + the [Unit] start-limit cap avoids a hot-loop;
# container-level crashes are handled by docker's restart policy, not systemd.
Restart=on-failure
RestartSec=10s

# TimeoutStartSec > the up -d + healthcheck-wait budget (daemon health ~30s).
TimeoutStartSec=200s
# Pinned (systemd's default) because the watchdogs' lock lifetimes are derived
# from start + stop: see tests/test_watchdog.py.
TimeoutStopSec=90s

# Hardening NOTE (2026-08-21 P0 fix): the previous ProtectHome=yes +
# ProtectSystem=strict masked the tinyassets user's docker config + compose CLI
# plugin (~/.docker), so `docker compose` failed under systemd with
# "unknown flag: --env-file" / "permission denied: /app/.docker/config.json" —
# systemctl start/restart could never bring the stack up (the crash-loop that
# took prod to 502). The daemon runs in a CONTAINER with its own isolation, so
# host-level sandboxing of the compose CLI was defense-in-depth at the cost of
# the unit actually working. Relaxed so `docker compose` resolves its plugin.
NoNewPrivileges=yes

# Journald captures compose stdout/stderr.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tinyassets-daemon

[Install]
WantedBy=multi-user.target
