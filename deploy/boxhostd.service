[Unit]
Description=TinyAssets box host (P2a idle preflight)
After=network.target docker.service
Wants=var-lib-boxhostd-owners.mount
After=var-lib-boxhostd-owners.mount
ConditionPathExists=/opt/tinyassets/boxhostd/current/runsc

[Service]
Type=simple
ExecStartPre=/opt/tinyassets/boxhostd/box-store-check.sh
ExecStart=/usr/bin/python3 /opt/tinyassets/boxhostd/boxhostd_idle.py
Restart=on-failure
RestartSec=5
Delegate=yes
RuntimeDirectory=tinyassets-boxhostd
RuntimeDirectoryMode=0700
MemoryMax=3G
CPUQuota=300%
TasksMax=5120

[Install]
WantedBy=multi-user.target
