# Count-based recoverable daemon image cache retention only: keep the running
# image, every container reference, the configured and receipt rollback refs,
# one rollback image and explicit tag pins;
# remove the rest (bounded, registry-verified). Pressure grades the pass.
# Started by the daily timer AND by deploy-prod.yml after a green canary.
# Same policy and serialization as hourly cleanup; no broad Docker prune.

[Unit]
Description=TinyAssets bounded daemon image retention (post-deploy + daily)
Documentation=https://github.com/TinyAssets/TinyAssets/blob/main/deploy/hetzner-bootstrap.sh
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/tinyassets/env
WorkingDirectory=/opt/tinyassets-host-uptime/current
ExecStartPre=/usr/bin/python3 /opt/tinyassets-host-uptime/current/scripts/backup_snapshot_retention.py --apply
ExecStart=/usr/bin/python3 /opt/tinyassets-host-uptime/current/scripts/disk_autoprune.py --apply
TimeoutStartSec=180s
PrivateTmp=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tinyassets-prune
