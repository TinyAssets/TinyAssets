# TinyAssets app-ingress shared secret.
#
# Install as /etc/tinyassets/app-ingress.env with owner root:tinyassets and
# mode 0640. deploy/compose.yml injects it into the daemon.
#
# Generate at least 32 random bytes and store their canonical single-line
# standard-base64 encoding — the same shape as the other daemon secrets:
#
#     openssl rand -base64 32
#
# Never commit a filled value.
#
# What this key authorises, stated plainly: the holder can ask the daemon to
# deliver a chat event AS ANY SENDER, and can fetch the `xapp-` socket token
# for a universe. It cannot read universe data and cannot post to Slack — the
# daemon posts, using credentials that never leave it.
#
# Fail-closed: with this unset the daemon does not open the ingress port at all.
#
# Rotation: replace the value and redeploy the daemon.
TINYASSETS_APP_INGRESS_HMAC_KEY=
