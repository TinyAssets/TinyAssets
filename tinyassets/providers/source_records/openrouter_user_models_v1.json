{
  "id": "openrouter_user_models_v1",
  "display_name": "OpenRouter",
  "origin": "declared",
  "addresses": [
    "https://openrouter.ai/api/v1",
    "https://openrouter.ai"
  ],
  "suggested": true,
  "execution": {
    "placement": [
      "thin_loop"
    ],
    "billing": [
      "free"
    ],
    "serves": "owner_only"
  },
  "sign_in": {
    "oauth": {
      "issuer": "https://openrouter.ai",
      "authorization_endpoint": "https://openrouter.ai/auth",
      "token_endpoint": "https://openrouter.ai/api/v1/auth/keys",
      "pkce": "S256",
      "client_strategy": "public_client",
      "protocol": "pkce_user_key_v1",
      "manual_key_entry": true,
      "help_url": "https://openrouter.ai/settings/keys",
      "authorize_params": {
        "key_label": "TinyAssets"
      }
    }
  },
  "invoke": {
    "http": {
      "wire": "chat_completions",
      "base_url": "https://openrouter.ai/api/v1",
      "models_url": "https://openrouter.ai/api/v1/models/user?output_modalities=all",
      "inference_url": "https://openrouter.ai/api/v1/chat/completions",
      "billing_url": "https://openrouter.ai/settings/credits",
      "benchmark_url": "https://openrouter.ai/api/v1/benchmarks",
      "discovery": {
        "compatibility_default": true,
        "transport": {
          "catalogue_path": "/api/v1/models/user",
          "catalogue_query": "output_modalities=all",
          "benchmark_path": "/api/v1/benchmarks",
          "auth_scheme": "bearer",
          "account_filtered": true,
          "inference_protocol": "openai_chat"
        },
        "catalogue": {
          "rows": "/data",
          "count": "/total_count",
          "next_page": "/links/next",
          "model_id": "/id",
          "join_key": "/canonical_slug",
          "inputs": "/architecture/input_modalities",
          "outputs": "/architecture/output_modalities",
          "tools": "/supported_parameters",
          "tools_member": "tools",
          "contexts": [
            "/context_length",
            "/top_provider/context_length"
          ],
          "prices": "/pricing"
        },
        "prices": {
          "fields": {
            "prompt": {
              "component": "input_million_tokens_usd",
              "scale": 1000000000000
            },
            "completion": {
              "component": "output_million_tokens_usd",
              "scale": 1000000000000
            },
            "request": {
              "component": "request_usd",
              "scale": 1000000
            },
            "image": {
              "component": "image_usd",
              "scale": 1000000
            },
            "audio": {
              "component": "audio_million_tokens_usd",
              "scale": 1000000000000
            },
            "audio_output": {
              "component": "audio_output_million_tokens_usd",
              "scale": 1000000000000
            },
            "image_output": {
              "component": "image_output_usd",
              "scale": 1000000
            },
            "image_token": {
              "component": "image_million_tokens_usd",
              "scale": 1000000000000
            },
            "input_audio_cache": {
              "component": "input_audio_cache_million_tokens_usd",
              "scale": 1000000000000
            },
            "input_cache_read": {
              "component": "input_cache_read_million_tokens_usd",
              "scale": 1000000000000
            },
            "input_cache_write": {
              "component": "input_cache_write_million_tokens_usd",
              "scale": 1000000000000
            },
            "input_cache_write_1h": {
              "component": "input_cache_write_1h_million_tokens_usd",
              "scale": 1000000000000
            },
            "internal_reasoning": {
              "component": "reasoning_million_tokens_usd",
              "scale": 1000000000000
            },
            "web_search": {
              "component": "web_search_usd",
              "scale": 1000000
            }
          },
          "required": [
            "prompt",
            "completion"
          ],
          "overrides": "/overrides",
          "metadata": [
            "discount",
            "overrides"
          ],
          "conditions": [
            "min_prompt_tokens",
            "utc_days",
            "utc_start",
            "utc_end"
          ]
        },
        "benchmark": {
          "rows": "/data",
          "count": "/total_count",
          "next_page": "/links/next",
          "source": "artificial-analysis",
          "source_field": "/source",
          "model_id": "/model_permaslug",
          "timestamp": "/meta/as_of",
          "agentic": "/agentic_index",
          "general": "/intelligence_index",
          "scale": 1000000
        },
        "inference": {
          "required": [
            "model",
            "messages"
          ],
          "allowed": [
            "model",
            "messages",
            "temperature",
            "max_tokens",
            "tools",
            "tool_choice"
          ],
          "caps": {
            "input_million_tokens_usd": {
              "path": "/provider/max_price/prompt",
              "divisor": 1000000
            },
            "output_million_tokens_usd": {
              "path": "/provider/max_price/completion",
              "divisor": 1000000
            },
            "request_usd": {
              "path": "/provider/max_price/request",
              "divisor": 1000000
            },
            "image_usd": {
              "path": "/provider/max_price/image",
              "divisor": 1000000
            }
          },
          "constants": [
            {
              "path": "/provider/require_parameters",
              "value": true,
              "charge_components": [
                "input_million_tokens_usd",
                "output_million_tokens_usd",
                "request_usd",
                "image_usd"
              ]
            }
          ],
          "model_exclusions": {
            "prefixes": [],
            "suffixes": [
              ":online"
            ],
            "substrings": [
              "@preset/"
            ]
          }
        },
        "interaction": {
          "needs_tools": false,
          "modalities": [
            "text"
          ],
          "min_context": 1,
          "charge_components": [
            "input_million_tokens_usd",
            "output_million_tokens_usd"
          ],
          "ceiling_components": [
            "input_million_tokens_usd",
            "output_million_tokens_usd",
            "request_usd",
            "image_usd"
          ],
          "excluded_components": [
            "audio_million_tokens_usd",
            "image_million_tokens_usd",
            "input_audio_cache_million_tokens_usd",
            "input_cache_write_1h_million_tokens_usd"
          ],
          "extra_price_bounds": [
            [
              "input_cache_read_million_tokens_usd",
              "input_million_tokens_usd"
            ],
            [
              "input_cache_write_million_tokens_usd",
              "input_million_tokens_usd"
            ],
            [
              "reasoning_million_tokens_usd",
              "output_million_tokens_usd"
            ],
            [
              "web_search_usd",
              null
            ],
            [
              "image_output_usd",
              null
            ],
            [
              "audio_output_million_tokens_usd",
              null
            ]
          ],
          "output_price_components": [
            [
              "image",
              "image_output_usd"
            ],
            [
              "audio",
              "audio_output_million_tokens_usd"
            ]
          ]
        },
        "capacity": {
          "cases": [
            {
              "status": 402,
              "scope": "account",
              "reason": "provider_credit_exhausted"
            },
            {
              "status": 429,
              "scope": "unknown",
              "reason": "provider_rate_limited"
            },
            {
              "status": 503,
              "scope": "model",
              "reason": "provider_overloaded"
            }
          ],
          "retry_after": true
        },
        "usage": {
          "cost": "/usage/cost",
          "scale": 1000000,
          "encoding": "number"
        }
      }
    }
  },
  "egress": {
    "provider": [
      "openrouter.ai"
    ]
  },
  "state": {
    "location": "broker"
  }
}
