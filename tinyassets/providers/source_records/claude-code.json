{
  "id": "claude-code",
  "display_name": "Claude",
  "invoke": {
    "cli": {
      "argv": [
        "{bin}",
        "-p",
        "--system-prompt",
        "{system}",
        "--output-format",
        "json",
        "--tools",
        "",
        "--strict-mcp-config",
        "--mcp-config",
        "{\"mcpServers\":{}}"
      ],
      "format": "json",
      "text_path": "result",
      "errors": {
        "is_error": true
      },
      "model_argv": [
        "--model",
        "{model}"
      ],
      "stdin": "{prompt}"
    }
  },
  "egress": {
    "registry": [
      "registry.npmjs.org"
    ],
    "login": [
      "claude.ai",
      "platform.claude.com",
      "console.anthropic.com",
      "api.anthropic.com",
      "claude.com"
    ],
    "provider": [
      "api.anthropic.com",
      "claude.ai",
      "claude.com"
    ]
  },
  "models": [
    {
      "id": "default",
      "context": 200000
    }
  ],
  "origin": "declared",
  "addresses": [
    "https://claude.ai",
    "https://anthropic.com",
    "https://claude.com"
  ],
  "suggested": false,
  "free": false,
  "sign_in": {
    "cli_login": {
      "install": {
        "manager": "npm",
        "package": "@anthropic-ai/claude-code",
        "version": "2.1.308",
        "integrity": "sha512-b2HnszgyN73wRTFP+IYPDJNn9ADXnG6jr26ibL+w03HSKqfb6GqE8Jnfr4mz37Zv4AT/NP+B5/3c1F89WTdWSA==",
        "bin": "claude",
        "lifecycle_scripts": true,
        "verify_argv": [
          "{bin}",
          "--version"
        ]
      },
      "login": {
        "argv": [
          "{bin}",
          "auth",
          "login"
        ],
        "status_argv": [
          "{bin}",
          "auth",
          "status"
        ],
        "status_equals": {
          "loggedIn": true,
          "authMethod": "claude.ai"
        },
        "url_pattern": "(https://(?:claude\\.com/cai|claude\\.ai)/oauth/authorize[^\\s\\u001b]+)",
        "accepts_code": true
      },
      "env": {
        "DISABLE_AUTOUPDATER": "1",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      }
    }
  },
  "state": {
    "location": "broker",
    "paths": [
      ".claude/.credentials.json"
    ]
  }
}
