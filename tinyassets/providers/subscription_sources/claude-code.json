{
  "id": "claude-code",
  "display_name": "Claude",
  "install": {
    "manager": "npm",
    "package": "@anthropic-ai/claude-code",
    "version": "2.1.308",
    "integrity": "sha512-b2HnszgyN73wRTFP+IYPDJNn9ADXnG6jr26ibL+w03HSKqfb6GqE8Jnfr4mz37Zv4AT/NP+B5/3c1F89WTdWSA==",
    "bin": "claude"
  },
  "login": {
    "argv": ["{bin}", "auth", "login"],
    "status_argv": ["{bin}", "auth", "status"],
    "status_equals": {"loggedIn": true, "authMethod": "claude.ai"},
    "url_pattern": "(https://claude\\.ai/oauth/authorize[^\\s\\u001b]+)",
    "accepts_code": true
  },
  "invoke": {
    "argv": ["{bin}", "-p", "{prompt}", "--system-prompt", "{system}", "--output-format", "json", "--tools", "", "--strict-mcp-config", "--mcp-config", "{\"mcpServers\":{}}"],
    "format": "json",
    "text_path": "result",
    "errors": {"is_error": true}
  },
  "egress": {
    "registry": ["registry.npmjs.org"],
    "login": ["claude.ai", "platform.claude.com", "console.anthropic.com", "api.anthropic.com"],
    "provider": ["api.anthropic.com", "claude.ai"]
  },
  "state_paths": [".claude/.credentials.json"],
  "env": {"DISABLE_AUTOUPDATER": "1", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"}
}
