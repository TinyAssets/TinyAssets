{
  "env": {
    "WORKFLOW_CLAUDE_MODEL": "opus"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch",
      "WebFetch(*)",
      "Agent(*)",
      "SendMessage(*)"
    ],
    "deny": [
      "Read(**/*.pyc)",
      "Read(**/.mypy_cache/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.ruff_cache/**)",
      "Read(**/.svelte-kit/**)",
      "Read(**/.wrangler/**)",
      "Read(**/__pycache__/**)",
      "Read(**/lancedb/**)",
      "Read(**/node_modules/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/session_sync_gate_hook.py\"",
            "shell": "powershell",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "python \".claude/hooks/dev_hygiene_hook.py\"",
            "shell": "powershell",
            "timeout": 50
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/supervisor_record.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \".claude/hooks/supervisor_check.py\""
          }
        ]
      }
    ]
  }
}
