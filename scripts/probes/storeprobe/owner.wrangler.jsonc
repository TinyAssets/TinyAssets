// The owner-like half of the store probe (store-probe.md). Throwaway: store-probe.yml
// deploys it through config.mjs (which bundles owner.js against platform/'s pinned pi
// packages and writes the low and raised copies) and deletes every copy. The runtime is
// the owner Worker's (platform/owner/wrangler.jsonc) exactly: the same date and flags,
// `disable_ctx_exports` among them, no workers.dev URL, no route, and its explicit
// `limits.subrequests: 10000`. Design (a') adds exactly one namespace binding, PISTORE, of
// the ThreadStore class in this same script, with no script_name (P3). The Owner class
// stands in for OwnerDO: the door binds it by script_name, as the doors bind OwnerDO.
{
  "name": "ta-storeprobe",
  "main": "owner.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "disable_ctx_exports"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "subrequests": 10000 },
  "durable_objects": {
    "bindings": [{ "name": "PISTORE", "class_name": "ThreadStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Owner", "ThreadStore"] }]
}
