# Business / fundraising material — NEVER committed. This repo is PUBLIC.
# These live untracked in the primary checkout and were unignored until
# 2026-08-26, which meant a single `git add -A` would have published a cap
# table, financials, and legal documents. Ignored here so the mistake is not
# available to make.
data-room/
pitch-deck/
investor-list/

# build_plugin.py serializes builds on this lock file (it never holds content).
packaging/claude-plugin/plugins/tinyassets-universe-server/runtime/.build.lock
