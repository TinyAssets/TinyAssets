{
  "id": "codex",
  "display_name": "ChatGPT",
  "connect": [
    "cli"
  ],
  "cli": {
    "install": {
      "manager": "npm",
      "lock_sha256": "6ffc00c778fed6527e4b4e1a25a742c9a6b9ffce0e84b6e083c57a8f5d8e51c9",
      "package": "@openai/codex",
      "version": "0.166.0",
      "integrity": "sha512-2Szlp1l1cz5TX1ccpX4Zok3DZrot9xeZe0km+6/1v8JmqxADwyJxKBJah4dBymkwtS25j/u6dipJusTOI97Z8Q==",
      "bin": "codex",
      "verify_argv": [
        "{bin}",
        "--version"
      ]
    },
    "credential": [
      "vendor_login_in_sandbox",
      "api_key"
    ],
    "login": {
      "argv": [
        "{bin}",
        "-c",
        "cli_auth_credentials_store=\"file\"",
        "-c",
        "forced_login_method=\"chatgpt\"",
        "login",
        "--device-auth"
      ],
      "status_argv": [
        "{bin}",
        "-c",
        "forced_login_method=\"chatgpt\"",
        "login",
        "status"
      ],
      "url_pattern": "(https://auth\\.openai\\.com/[^\\s\\u001b]+)",
      "code_pattern": "\\b([A-Z0-9]{4}-[A-Z0-9]{4,5})\\b",
      "state_checks": [
        {
          "path": "{home}/.codex/auth.json",
          "present": [
            "tokens.access_token",
            "tokens.refresh_token"
          ]
        }
      ]
    },
    "api_key_env": {
      "openai": {
        "base_url": "OPENAI_BASE_URL",
        "api_key": "CODEX_API_KEY",
        "base": "sealed"
      }
    },
    "unattended": {
      "vendor_login_in_sandbox": {
        "allowed": false,
        "reason": "OpenAI documents ChatGPT-login automation only on trusted private infrastructure, and hosted Sign in with ChatGPT goes through its interest form; no page permits a hosted, unattended Codex on a ChatGPT plan (subscription-engines §2, §11)."
      },
      "api_key": {
        "allowed": true,
        "cite": "https://developers.openai.com/codex/auth",
        "read": "2026-11-01",
        "read_note": "Read through the search index's text of the page only; the page itself was not fetched."
      }
    },
    "per_credential": {
      "vendor_login_in_sandbox": {
        "argv": [
          "-c",
          "forced_login_method=\"chatgpt\"",
          "-c",
          "cli_auth_credentials_store=\"file\""
        ],
        "forbid_env": [
          "CODEX_API_KEY",
          "OPENAI_API_KEY",
          "OPENAI_BASE_URL"
        ]
      },
      "api_key": {
        "argv": [
          "-c",
          "forced_login_method=\"api\""
        ]
      }
    },
    "engine": {
      "argv": [
        "{bin}",
        "exec",
        "--json",
        "--skip-git-repo-check",
        "-"
      ],
      "resume_argv": [
        "{bin}",
        "exec",
        "--json",
        "--skip-git-repo-check",
        "resume",
        "{sid}",
        "-"
      ],
      "resume": "session_id",
      "stdin": "{prompt}",
      "model_argv": [
        "--model",
        "{model}"
      ],
      "events": {
        "format": "jsonl",
        "session_id": [
          {
            "match": {
              "type": "thread.started"
            },
            "path": "thread_id"
          }
        ],
        "final_text": [
          {
            "match": {
              "type": "item.completed",
              "item.type": "agent_message"
            },
            "path": "item.text"
          }
        ],
        "error": [
          {
            "match": {
              "type": "turn.failed"
            },
            "path": "error.message"
          },
          {
            "match": {
              "type": "error"
            },
            "path": "message"
          }
        ],
        "usage": [
          {
            "match": {
              "type": "turn.completed"
            },
            "path": "usage"
          }
        ],
        "tool_call": [
          {
            "match": {
              "type": "item.completed",
              "item.type": "command_execution"
            },
            "path": "item"
          },
          {
            "match": {
              "type": "item.completed",
              "item.type": "mcp_tool_call"
            },
            "path": "item"
          },
          {
            "match": {
              "type": "item.completed",
              "item.type": "file_change"
            },
            "path": "item"
          }
        ]
      }
    },
    "instructions": {
      "file": "AGENTS.md",
      "shadowed_by": [
        "AGENTS.override.md"
      ],
      "max_bytes": 32768
    },
    "skills_paths": [
      ".agents/skills"
    ],
    "mcp": {
      "argv": [
        "-c",
        "mcp_servers.tinyassets.url=\"{mcp_url}\""
      ],
      "trust": {
        "argv": [],
        "note": "A server given by -c is the run's own config, read without a project-trust prompt in exec mode."
      }
    },
    "tools": {
      "deny": {
        "argv": [
          "-c",
          "features.{tool}=false"
        ],
        "each": true
      }
    },
    "unattended_argv": [
      "-c",
      "approval_policy=\"never\"",
      "-c",
      "sandbox_mode=\"danger-full-access\""
    ],
    "home_env": {
      "CODEX_HOME": "{home}/.codex"
    },
    "no_update": {
      "argv": [
        "-c",
        "check_for_update_on_startup=false"
      ]
    },
    "secret_paths": [
      "{home}/.codex/auth.json",
      "{home}/.codex/.credentials.json"
    ],
    "session_paths": [
      "{home}/.codex/sessions/"
    ],
    "hosts": {
      "registry": [
        "registry.npmjs.org"
      ],
      "login": [
        "auth.openai.com",
        "chatgpt.com"
      ],
      "provider": [
        "chatgpt.com",
        "auth.openai.com"
      ]
    }
  }
}
