{
  "id": "gemini",
  "display_name": "Gemini",
  "connect": [
    "cli"
  ],
  "cli": {
    "install": {
      "manager": "npm",
      "lock_sha256": "cbc217f75509077138f3a0d9127c959c71a271ba13c9cecb19628a27efd8f2e0",
      "package": "@google/gemini-cli",
      "version": "0.66.0",
      "integrity": "sha512-EAtsJ9/JxiphHlduzvhoCkb7I0LdOxyugB5NpUtVqKVGZIWjV3JmurvK89ZrvMbV3kwk5SdWINz1M5ZN/2K/Lw==",
      "bin": "gemini",
      "verify_argv": [
        "{bin}",
        "--version"
      ],
      "lifecycle_scripts": true
    },
    "credential": [
      "vendor_login_in_sandbox",
      "api_key"
    ],
    "login": {
      "argv": [
        "{bin}"
      ],
      "url_pattern": "(https://accounts\\.google\\.com/[^\\s\\u001b]+)",
      "accepts_code": true,
      "state_checks": [
        {
          "path": "{home}/.gemini/oauth_creds.json",
          "present": [
            "access_token",
            "refresh_token"
          ]
        }
      ],
      "complete_on_state": true,
      "url": {
        "hosts": [
          "accounts.google.com"
        ],
        "path": "/o/oauth2/v2/auth",
        "params": {
          "redirect_uri": "https://codeassist.google.com/authcode",
          "access_type": "offline",
          "scope": "https://www.googleapis.com/auth/cloud-platform https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile",
          "code_challenge_method": "S256",
          "response_type": "code",
          "client_id": "681255809395-oo8ft2oprdrnp9e3aqf6av3hmdib135j.apps.googleusercontent.com"
        },
        "free": [
          "code_challenge",
          "state"
        ]
      },
      "expires": {
        "s": 300,
        "citation": "@google/gemini-cli 0.66.0 bundle/chunk-HJ5KJXNZ.js authWithUserCode: Authorization timed out after 5 minutes (setTimeout 3e5), read 2026-11-03"
      },
      "hosted_use": {
        "verdict": "unclear",
        "citation": "gemini-cli docs/resources/tos-privacy.md: third-party software using Gemini CLI OAuth to reach its services is a violation; a platform hosting the unmodified CLI for the user's own sign-in is not addressed (subscription-engines.md section 11)"
      }
    },
    "api_key_env": {
      "google": {
        "base_url": "GOOGLE_GEMINI_BASE_URL",
        "api_key": "GEMINI_API_KEY",
        "base": "connection"
      }
    },
    "unattended": {
      "vendor_login_in_sandbox": {
        "allowed": false,
        "reason": "Unclear: Google's Gemini CLI terms do not say whether a platform may run the unmodified CLI unattended on a member's own Google sign-in, and no Google page read permits it (subscription-engines \u00a73, \u00a711).",
        "cite": "https://github.com/google-gemini/gemini-cli/blob/main/docs/resources/tos-privacy.md",
        "read": "2026-11-01"
      },
      "api_key": {
        "allowed": true,
        "cite": "https://github.com/google-gemini/gemini-cli/blob/main/docs/get-started/authentication.mdx",
        "read": "2026-11-01"
      }
    },
    "per_credential": {
      "vendor_login_in_sandbox": {
        "files": {
          "{home}/.gemini/settings.json": "{\"security\": {\"auth\": {\"selectedType\": \"oauth-personal\", \"enforcedType\": \"oauth-personal\"}}}"
        },
        "forbid_env": [
          "GEMINI_API_KEY",
          "GOOGLE_API_KEY",
          "GOOGLE_GEMINI_BASE_URL",
          "GOOGLE_BASE_URL",
          "GOOGLE_GENAI_USE_VERTEXAI",
          "GEMINI_CLI_USE_COMPUTE_ADC",
          "CODE_ASSIST_ENDPOINT",
          "GOOGLE_GENAI_USE_GCA",
          "GOOGLE_CLOUD_ACCESS_TOKEN",
          "GOOGLE_APPLICATION_CREDENTIALS",
          "GOOGLE_VERTEX_BASE_URL",
          "GEMINI_CLI_AUTH_OVERRIDE",
          "GEMINI_DEFAULT_AUTH_TYPE"
        ]
      },
      "api_key": {
        "files": {
          "{home}/.gemini/settings.json": "{\"security\": {\"auth\": {\"selectedType\": \"gemini-api-key\", \"enforcedType\": \"gemini-api-key\"}}}"
        }
      }
    },
    "engine": {
      "argv": [
        "{bin}",
        "--output-format",
        "stream-json"
      ],
      "resume_argv": [
        "{bin}",
        "--output-format",
        "stream-json",
        "--resume",
        "{sid}"
      ],
      "resume": "session_id",
      "stdin": "{prompt}",
      "model_argv": [
        "--model",
        "{model}"
      ],
      "events": {
        "format": "jsonl",
        "session_id": [
          {
            "match": {
              "type": "init"
            },
            "path": "session_id"
          }
        ],
        "final_text": [
          {
            "match": {
              "type": "message",
              "role": "assistant"
            },
            "path": "content",
            "accumulate": true
          }
        ],
        "error": [
          {
            "match": {
              "type": "error"
            },
            "path": "message"
          },
          {
            "match": {
              "type": "result",
              "status": "error"
            },
            "path": "error"
          }
        ],
        "usage": [
          {
            "match": {
              "type": "result"
            },
            "path": "stats"
          }
        ],
        "tool_call": [
          {
            "match": {
              "type": "tool_use"
            },
            "path": ""
          }
        ]
      }
    },
    "instructions": {
      "file": "AGENTS.md",
      "shadowed_by": [],
      "setting": "{system}/gemini-settings.json"
    },
    "skills_paths": [
      ".agents/skills"
    ],
    "mcp": {
      "file": "{system}/gemini-settings.json",
      "template": "{\"mcpServers\": {\"tinyassets\": {\"httpUrl\": \"{mcp_url}\"}}, \"mcp\": {\"allowed\": [\"tinyassets\"]}, \"context\": {\"fileName\": [\"AGENTS.md\"]}, \"telemetry\": {\"enabled\": false}, \"general\": {\"disableAutoUpdate\": true}, \"security\": {\"folderTrust\": {\"enabled\": false}}}",
      "argv": [],
      "trust": {
        "argv": [
          "--allowed-mcp-server-names",
          "tinyassets"
        ],
        "note": "The server is in the system settings, outside the agent's folder, and only it is allowed to load."
      }
    },
    "tools": {
      "allow": {
        "file": "{system}/gemini-settings.json",
        "key": "tools.core"
      },
      "deny": {
        "file": "{system}/gemini-settings.json",
        "key": "tools.exclude"
      }
    },
    "unattended_argv": [
      "--approval-mode",
      "yolo"
    ],
    "home_env": {
      "GEMINI_CLI_HOME": "{home}"
    },
    "env": {
      "NO_BROWSER": "true",
      "GEMINI_CLI_SYSTEM_SETTINGS_PATH": "{system}/gemini-settings.json"
    },
    "no_update": {
      "file": "{system}/gemini-settings.json"
    },
    "secret_paths": [
      "{home}/.gemini/oauth_creds.json",
      "{home}/.gemini/mcp-oauth-tokens.json",
      "{home}/.gemini/a2a-oauth-tokens.json",
      "{home}/.gemini/gemini-credentials.json"
    ],
    "session_paths": [
      "{home}/.gemini/tmp/*/chats/"
    ],
    "hosts": {
      "registry": [
        "registry.npmjs.org"
      ],
      "login": [
        "accounts.google.com",
        "oauth2.googleapis.com",
        "www.googleapis.com",
        "cloudcode-pa.googleapis.com",
        "codeassist.google.com"
      ],
      "provider": [
        "oauth2.googleapis.com",
        "www.googleapis.com",
        "cloudcode-pa.googleapis.com"
      ]
    }
  }
}
