{
  "id": "claude-code",
  "display_name": "Claude",
  "connect": [
    "cli"
  ],
  "cli": {
    "install": {
      "manager": "npm",
      "lock_sha256": "866e7dfde2719901e137f84bb2f4dd0ce7264e21e9246933d6861ab8ee7dbdb6",
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.309",
      "integrity": "sha512-+lBYZRuXOJpiKJcRv/CK7gF+5UFNWyJE7hSxkgGUKDZOWgANl9MAabfTkrJk183Tp3B0Nv4xF/DU1t0BaKXOPw==",
      "bin": "claude",
      "lifecycle_scripts": true,
      "verify_argv": [
        "{bin}",
        "--version"
      ]
    },
    "credential": [
      "vendor_login_in_sandbox",
      "api_key"
    ],
    "login": {
      "argv": [
        "{bin}",
        "auth",
        "login"
      ],
      "status_argv": [
        "{bin}",
        "auth",
        "status"
      ],
      "status_equals": {
        "loggedIn": true,
        "authMethod": "claude.ai"
      },
      "url_pattern": "(https://(?:claude\\.com/cai|claude\\.ai)/oauth/authorize[^\\s\\u001b]+)",
      "accepts_code": true,
      "logout_argv": [
        "{bin}",
        "auth",
        "logout"
      ],
      "url": {
        "hosts": [
          "claude.com"
        ],
        "path": "/cai/oauth/authorize",
        "params": {
          "code": "true",
          "client_id": "9d1c250a-e61b-44d9-88ed-5944d1962f5e",
          "response_type": "code",
          "redirect_uri": "https://platform.claude.com/oauth/code/callback",
          "scope": "org:create_api_key user:profile user:inference user:sessions:claude_code user:mcp_servers user:file_upload user:plugins",
          "code_challenge_method": "S256"
        },
        "free": [
          "code_challenge",
          "state"
        ]
      },
      "expires": {
        "s": 600,
        "citation": "the platform's own bound on an open sign-in, not Anthropic's: it runs from the sign-in's start, so it covers the owner's password, 2FA and account steps too, and an open sign-in keeps a metered sandbox up (limits-audit.md). Anthropic documents no lifetime, and claude 2.1.309's auth login waits for the code with no timer of its own (waitForAuthorizationCode); RFC 6749 section 4.1.2's 10-minute maximum for an authorization code is context only, since it runs from the code's issue. The time a real sign-in with 2FA takes is owed to the founder's live test, and sets this if 600 s is too tight"
      },
      "hosted_use": {
        "verdict": "allowed",
        "citation": "code.claude.com/docs/en/legal-and-compliance.md (read 2026-11-03): an end user may sign in to the unmodified Claude Code binary with their own subscription, including where a platform hosts it, under the Commercial Terms; the platform may not collect, store or intermediate the credentials"
      }
    },
    "api_key_env": {
      "anthropic": {
        "base_url": "ANTHROPIC_BASE_URL",
        "api_key": "ANTHROPIC_API_KEY",
        "base": "sealed"
      }
    },
    "unattended": {
      "vendor_login_in_sandbox": {
        "allowed": true,
        "cite": "https://code.claude.com/docs/en/legal-and-compliance",
        "read": "2026-11-01"
      },
      "api_key": {
        "allowed": true,
        "cite": "https://code.claude.com/docs/en/legal-and-compliance",
        "read": "2026-11-01"
      }
    },
    "per_credential": {
      "vendor_login_in_sandbox": {
        "forbid_argv": [
          "--bare"
        ],
        "forbid_env": [
          "CLAUDE_CODE_USE_BEDROCK",
          "CLAUDE_CODE_USE_VERTEX",
          "CLAUDE_CODE_USE_FOUNDRY",
          "ANTHROPIC_AUTH_TOKEN",
          "ANTHROPIC_API_KEY",
          "ANTHROPIC_BASE_URL",
          "CLAUDE_CODE_USE_GATEWAY",
          "CLAUDE_CODE_GATEWAY_TOKEN",
          "CLAUDE_CODE_USE_MANTLE",
          "ANTHROPIC_FOUNDRY_API_KEY",
          "ANTHROPIC_FOUNDRY_AUTH_TOKEN",
          "ANTHROPIC_AWS_API_KEY",
          "ANTHROPIC_AWS_BASE_URL",
          "ANTHROPIC_BEDROCK_BASE_URL",
          "ANTHROPIC_VERTEX_BASE_URL",
          "CLAUDE_CODE_OAUTH_TOKEN"
        ]
      }
    },
    "engine": {
      "argv": [
        "{bin}",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--include-partial-messages"
      ],
      "resume_argv": [
        "{bin}",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--include-partial-messages",
        "--resume",
        "{sid}"
      ],
      "resume": "session_id",
      "stdin": "{prompt}",
      "model_argv": [
        "--model",
        "{model}"
      ],
      "events": {
        "format": "jsonl",
        "session_id": [
          {
            "match": {
              "type": "system",
              "subtype": "init"
            },
            "path": "session_id"
          }
        ],
        "final_text": [
          {
            "match": {
              "type": "result"
            },
            "path": "result"
          }
        ],
        "error": [
          {
            "match": {
              "type": "result",
              "is_error": true
            },
            "path": "result"
          },
          {
            "match": {
              "type": "system",
              "subtype": "api_retry"
            },
            "path": "error"
          }
        ],
        "usage": [
          {
            "match": {
              "type": "result"
            },
            "path": "usage"
          }
        ],
        "tool_call": [
          {
            "match": {
              "type": "assistant"
            },
            "path": "message.content"
          }
        ]
      }
    },
    "instructions": {
      "file": "AGENTS.md",
      "shadowed_by": [
        "CLAUDE.md",
        "CLAUDE.local.md"
      ]
    },
    "skills_paths": [
      ".claude/skills"
    ],
    "mcp": {
      "file": "{home}/run/mcp.json",
      "template": "{\"mcpServers\": {\"tinyassets\": {\"type\": \"http\", \"url\": \"{mcp_url}\", \"headers\": {\"x-ta-run\": \"{run_secret}\"}}}}",
      "argv": [
        "--mcp-config",
        "{mcp_config}",
        "--strict-mcp-config"
      ],
      "trust": {
        "argv": [],
        "note": "A non-bare -p run loads its --mcp-config without folder trust; --strict-mcp-config ignores every other server. Neither is restored on resume, so both go on every run."
      }
    },
    "run_secret_env": {
      "env": "ANTHROPIC_CUSTOM_HEADERS",
      "value": "x-ta-run: {run_secret}"
    },
    "tools": {
      "allow": {
        "argv": [
          "--tools",
          "{tools}"
        ],
        "join": ","
      },
      "deny": {
        "argv": [
          "--disallowedTools",
          "{tools}"
        ],
        "join": ","
      }
    },
    "unattended_argv": [
      "--permission-mode",
      "auto",
      "--permission-prompts",
      "none"
    ],
    "home_env": {
      "CLAUDE_CONFIG_DIR": "{home}/.claude"
    },
    "env": {
      "CLAUDE_CODE_PROJECT_DIR_NAME": "{agent}",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
    },
    "no_update": {
      "env": {
        "DISABLE_AUTOUPDATER": "1"
      }
    },
    "secret_paths": [
      "{home}/.claude/.credentials.json",
      "{home}/.claude/.claude.json"
    ],
    "session_paths": [
      "{home}/.claude/projects/"
    ],
    "hosts": {
      "registry": [
        "registry.npmjs.org"
      ],
      "login": [
        "claude.ai",
        "platform.claude.com",
        "console.anthropic.com",
        "api.anthropic.com",
        "claude.com"
      ],
      "provider": [
        "api.anthropic.com",
        "claude.ai",
        "claude.com",
        "platform.claude.com"
      ]
    }
  }
}
