{
  "id": "claude-code",
  "display_name": "Claude",
  "connect": [
    "cli"
  ],
  "cli": {
    "install": {
      "manager": "npm",
      "lock_sha256": "866e7dfde2719901e137f84bb2f4dd0ce7264e21e9246933d6861ab8ee7dbdb6",
      "package": "@anthropic-ai/claude-code",
      "version": "2.1.309",
      "integrity": "sha512-+lBYZRuXOJpiKJcRv/CK7gF+5UFNWyJE7hSxkgGUKDZOWgANl9MAabfTkrJk183Tp3B0Nv4xF/DU1t0BaKXOPw==",
      "bin": "claude",
      "lifecycle_scripts": true,
      "verify_argv": [
        "{bin}",
        "--version"
      ]
    },
    "credential": [
      "vendor_login_in_sandbox",
      "api_key"
    ],
    "login": {
      "argv": [
        "{bin}",
        "auth",
        "login"
      ],
      "status_argv": [
        "{bin}",
        "auth",
        "status"
      ],
      "status_equals": {
        "loggedIn": true,
        "authMethod": "claude.ai"
      },
      "url_pattern": "(https://(?:claude\\.com/cai|claude\\.ai)/oauth/authorize[^\\s\\u001b]+)",
      "accepts_code": true
    },
    "api_key_env": {
      "anthropic": {
        "base_url": "ANTHROPIC_BASE_URL",
        "api_key": "ANTHROPIC_API_KEY",
        "base": "sealed"
      }
    },
    "unattended": {
      "vendor_login_in_sandbox": {
        "allowed": true,
        "cite": "https://code.claude.com/docs/en/legal-and-compliance",
        "read": "2026-11-01"
      },
      "api_key": {
        "allowed": true,
        "cite": "https://code.claude.com/docs/en/legal-and-compliance",
        "read": "2026-11-01"
      }
    },
    "per_credential": {
      "vendor_login_in_sandbox": {
        "forbid_argv": [
          "--bare"
        ],
        "forbid_env": [
          "CLAUDE_CODE_USE_BEDROCK",
          "CLAUDE_CODE_USE_VERTEX",
          "CLAUDE_CODE_USE_FOUNDRY",
          "ANTHROPIC_AUTH_TOKEN",
          "ANTHROPIC_API_KEY",
          "ANTHROPIC_BASE_URL"
        ]
      }
    },
    "engine": {
      "argv": [
        "{bin}",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--include-partial-messages"
      ],
      "resume_argv": [
        "{bin}",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--include-partial-messages",
        "--resume",
        "{sid}"
      ],
      "resume": "session_id",
      "stdin": "{prompt}",
      "model_argv": [
        "--model",
        "{model}"
      ],
      "events": {
        "format": "jsonl",
        "session_id": [
          {
            "match": {
              "type": "system",
              "subtype": "init"
            },
            "path": "session_id"
          }
        ],
        "final_text": [
          {
            "match": {
              "type": "result"
            },
            "path": "result"
          }
        ],
        "error": [
          {
            "match": {
              "type": "result",
              "is_error": true
            },
            "path": "result"
          },
          {
            "match": {
              "type": "system",
              "subtype": "api_retry"
            },
            "path": "error"
          }
        ],
        "usage": [
          {
            "match": {
              "type": "result"
            },
            "path": "usage"
          }
        ],
        "tool_call": [
          {
            "match": {
              "type": "assistant"
            },
            "path": "message.content"
          }
        ]
      }
    },
    "instructions": {
      "file": "AGENTS.md",
      "shadowed_by": [
        "CLAUDE.md",
        "CLAUDE.local.md"
      ]
    },
    "skills_paths": [
      ".claude/skills"
    ],
    "mcp": {
      "file": "{home}/run/mcp.json",
      "template": "{\"mcpServers\": {\"tinyassets\": {\"type\": \"http\", \"url\": \"{mcp_url}\"}}}",
      "argv": [
        "--mcp-config",
        "{mcp_config}",
        "--strict-mcp-config"
      ],
      "trust": {
        "argv": [],
        "note": "A non-bare -p run loads its --mcp-config without folder trust; --strict-mcp-config ignores every other server. Neither is restored on resume, so both go on every run."
      }
    },
    "tools": {
      "allow": {
        "argv": [
          "--tools",
          "{tools}"
        ],
        "join": ","
      },
      "deny": {
        "argv": [
          "--disallowedTools",
          "{tools}"
        ],
        "join": ","
      }
    },
    "unattended_argv": [
      "--permission-mode",
      "auto",
      "--permission-prompts",
      "none"
    ],
    "home_env": {
      "CLAUDE_CONFIG_DIR": "{home}/.claude"
    },
    "env": {
      "CLAUDE_CODE_PROJECT_DIR_NAME": "{agent}",
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
      "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
    },
    "no_update": {
      "env": {
        "DISABLE_AUTOUPDATER": "1"
      }
    },
    "secret_paths": [
      "{home}/.claude/.credentials.json",
      "{home}/.claude/.claude.json"
    ],
    "session_paths": [
      "{home}/.claude/projects/"
    ],
    "hosts": {
      "registry": [
        "registry.npmjs.org"
      ],
      "login": [
        "claude.ai",
        "platform.claude.com",
        "console.anthropic.com",
        "api.anthropic.com",
        "claude.com"
      ],
      "provider": [
        "api.anthropic.com",
        "claude.ai",
        "claude.com",
        "platform.claude.com"
      ]
    }
  }
}
