{
  "id": "kimi",
  "display_name": "Kimi",
  "connect": [
    "cli"
  ],
  "cli": {
    "install": {
      "manager": "npm",
      "lock_sha256": "5f38c028a086454550aae20aa7e81e78a4fa23645a7def487058a11abce6adf1",
      "package": "@moonshot-ai/kimi-code",
      "version": "2.4.1",
      "integrity": "sha512-z0py3AxbV9ykOB3Pgh2FiycZbMy7XSAXH4Kb1yfyhhmk+l9xH8H9raakVvCGMYLVxxEQGitQLcgOh8clLVYUTw==",
      "bin": "kimi",
      "verify_argv": [
        "{bin}",
        "--version"
      ]
    },
    "credential": [
      "vendor_login_in_sandbox"
    ],
    "login": {
      "argv": [
        "{bin}",
        "login",
        "--region",
        "mainland-cn"
      ],
      "url_pattern": "(https://(?:www\\.kimi\\.com|auth\\.kimi\\.com)/[^\\s\\u001b]+)",
      "code_pattern": "enter code: ([A-Za-z0-9-]+)",
      "state_checks": [
        {
          "path": "{home}/.kimi-code/credentials/kimi-code.json",
          "present": [
            "access_token",
            "refresh_token"
          ]
        }
      ]
    },
    "unattended": {
      "vendor_login_in_sandbox": {
        "allowed": false,
        "reason": "No Kimi page read addresses hosted or unattended use of the CLI on a membership, and its help center warns that use with unauthorized platforms or tools may be a violation (subscription-engines §5, §11)."
      }
    },
    "engine": {
      "argv": [
        "{bin}",
        "--prompt",
        "{prompt}",
        "--output-format",
        "stream-json"
      ],
      "resume_argv": [
        "{bin}",
        "--continue",
        "--prompt",
        "{prompt}",
        "--output-format",
        "stream-json"
      ],
      "resume": "continue_in_cwd",
      "model_argv": [
        "--model",
        "{model}"
      ],
      "events": {
        "format": "jsonl",
        "session_id": [],
        "final_text": [
          {
            "match": {
              "role": "assistant"
            },
            "path": "content"
          }
        ],
        "error": [],
        "usage": [],
        "tool_call": [
          {
            "match": {
              "role": "assistant"
            },
            "path": "tool_calls"
          }
        ]
      }
    },
    "instructions": {
      "file": "AGENTS.md",
      "shadowed_by": []
    },
    "skills_paths": [
      ".agents/skills"
    ],
    "mcp": {
      "file": "{home}/.kimi-code/mcp.json",
      "template": "{\"mcpServers\": {\"tinyassets\": {\"url\": \"{mcp_url}\", \"transport\": \"http\"}}}",
      "argv": [],
      "trust": {
        "argv": [],
        "note": "The server is in the user-level mcp.json, which needs no workspace trust; a project-level one would."
      }
    },
    "tools": {},
    "unattended_argv": [],
    "home_env": {
      "KIMI_CODE_HOME": "{home}/.kimi-code"
    },
    "no_update": {
      "reason": "No auto-update switch is documented in what was read; the template pins the npm package and slice S checks the CLI leaves it unchanged."
    },
    "secret_paths": [
      "{home}/.kimi-code/credentials/",
      "{home}/.kimi-code/config.toml"
    ],
    "session_paths": [
      "{home}/.kimi-code/sessions/",
      "{home}/.kimi-code/session_index.jsonl"
    ],
    "hosts": {
      "registry": [
        "registry.npmjs.org"
      ],
      "login": [
        "auth.kimi.com",
        "api.kimi.com",
        "www.kimi.com"
      ],
      "provider": [
        "auth.kimi.com",
        "api.kimi.com"
      ]
    }
  }
}
