{
  "id": "openrouter_messages",
  "display_name": "OpenRouter: Claude models",
  "suggested": true,
  "help_url": "https://openrouter.ai/settings/keys",
  "connect": [
    "oauth",
    "api_key"
  ],
  "provider": "openrouter",
  "api": "anthropic-messages",
  "base_url": "https://openrouter.ai/api",
  "auth": {
    "header": "x-api-key",
    "scheme": ""
  },
  "verify_url": "https://openrouter.ai/api/v1/models/user",
  "endpoints": [
    {
      "origin": "https://openrouter.ai",
      "paths": [
        "/api/v1/messages"
      ],
      "methods": [
        "POST"
      ]
    },
    {
      "origin": "https://openrouter.ai",
      "paths": [
        "/api/v1/models/user",
        "/api/v1/benchmarks",
        "/api/v1/key"
      ],
      "methods": [
        "GET"
      ]
    }
  ],
  "engines": [
    "pi"
  ],
  "credit": {
    "url": "https://openrouter.ai/api/v1/key",
    "none_when": [
      {
        "path": [
          "data",
          "is_free_tier"
        ],
        "equals": true
      },
      {
        "path": [
          "data",
          "limit_remaining"
        ],
        "at_most": 0
      }
    ],
    "refused": [
      402
    ],
    "free": [
      "*:free"
    ],
    "cite": "https://openrouter.ai/docs/api_reference/limits"
  },
  "listing": {
    "url": "https://openrouter.ai/api/v1/models/user",
    "rows": [
      "data"
    ],
    "id": [
      "id"
    ],
    "score": [
      "benchmarks",
      "artificial_analysis",
      "intelligence_index"
    ],
    "cite": "https://openrouter.ai/docs/client-sdks/typescript/models/aabenchmarkentry"
  },
  "oauth": {
    "protocol": "pkce_user_key_v1",
    "authorization_endpoint": "https://openrouter.ai/auth",
    "exchange_endpoint": "https://openrouter.ai/api/v1/auth/keys",
    "authorize_params": {
      "key_label": "TinyAssets"
    }
  }
}
