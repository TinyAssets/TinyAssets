{
  "id": "pi",
  "display_name": "pi",
  "connect": [
    "cli"
  ],
  "cli": {
    "install": {
      "manager": "npm",
      "lock_sha256": "792d133e5ec081063d9dfbd42950ee1f622ac99acd26ecd0cff8d140aae65e57",
      "package": "@earendil-works/pi-coding-agent",
      "version": "1.4.0",
      "integrity": "sha512-Z41LpZ3yYHSC/UUps6Mr39UMFPwH8elhJBG9DY1P7kuzsE5qSK/6eMj2EHzO5evJRQWLbKSqUMw+4nCNtIyiQg==",
      "bin": "pi",
      "verify_argv": [
        "{bin}",
        "--version"
      ],
      "lifecycle_scripts": true
    },
    "credential": [
      "api_key"
    ],
    "api_key_env": {
      "anthropic": {
        "base_url": null,
        "api_key": "ANTHROPIC_API_KEY",
        "base": "sealed"
      },
      "openai": {
        "base_url": null,
        "api_key": "OPENAI_API_KEY",
        "base": "sealed"
      },
      "xai": {
        "base_url": null,
        "api_key": "XAI_API_KEY",
        "base": "sealed"
      },
      "google": {
        "base_url": null,
        "api_key": "GEMINI_API_KEY",
        "base": "sealed"
      },
      "groq": {
        "base_url": null,
        "api_key": "GROQ_API_KEY",
        "base": "sealed"
      },
      "cerebras": {
        "base_url": null,
        "api_key": "CEREBRAS_API_KEY",
        "base": "sealed"
      },
      "mistral": {
        "base_url": null,
        "api_key": "MISTRAL_API_KEY",
        "base": "sealed"
      },
      "openrouter": {
        "base_url": null,
        "api_key": "OPENROUTER_API_KEY",
        "base": "sealed"
      }
    },
    "unattended": {
      "api_key": {
        "allowed": true,
        "cite": "https://www.npmjs.com/package/@earendil-works/pi-coding-agent",
        "read": "2026-11-01"
      }
    },
    "engine": {
      "argv": [
        "{bin}",
        "--mode",
        "json"
      ],
      "resume_argv": [
        "{bin}",
        "--mode",
        "json",
        "--session",
        "{sid}"
      ],
      "resume": "session_id",
      "stdin": "{prompt}",
      "model_argv": [
        "--provider",
        "{provider}",
        "--model",
        "{model}"
      ],
      "events": {
        "format": "jsonl",
        "session_id": [
          {
            "match": {
              "type": "session"
            },
            "path": "id"
          }
        ],
        "final_text": [
          {
            "match": {
              "type": "message_end",
              "message.role": "assistant"
            },
            "path": "message.content"
          }
        ],
        "error": [
          {
            "match": {
              "type": "message_end",
              "message.stopReason": "error"
            },
            "path": "message.errorMessage"
          }
        ],
        "usage": [
          {
            "match": {
              "type": "message_end",
              "message.role": "assistant"
            },
            "path": "message.usage"
          }
        ],
        "tool_call": [
          {
            "match": {
              "type": "tool_execution_start"
            },
            "path": ""
          }
        ],
        "deferred": []
      }
    },
    "instructions": {
      "file": "AGENTS.md",
      "shadowed_by": []
    },
    "skills_paths": [
      ".pi/skills"
    ],
    "mcp": {
      "file": "{home}/.pi/agent/mcp.json",
      "template": "{\"mcpServers\": {\"tinyassets\": {\"url\": \"{mcp_url}\", \"exposure\": \"direct\"}}}",
      "argv": [],
      "trust": {
        "argv": [],
        "note": "A user-level server in the agent directory's mcp.json loads without project trust; only a project's .pi/mcp.json needs it (pi docs/mcp.md)."
      }
    },
    "decide": {
      "file": "{system}/decide.mjs",
      "template": "import { spawn } from \"node:child_process\";\nconst MATCHER = new RegExp(\"{matcher}\");\nconst [command, ...args] = JSON.parse(\"{decide_argv}\");\nexport default function (pi) {\n  pi.on(\"tool_call\", (event) => MATCHER.test(event.toolName) ? new Promise((done) => {\n    const env = Object.fromEntries([\"{decide_env}\", \"NODE_EXTRA_CA_CERTS\"]\n      .filter((name) => process.env[name] !== undefined).map((name) => [name, process.env[name]]));\n    const helper = spawn(command, args, { env, stdio: [\"pipe\", \"ignore\", \"pipe\"] });\n    let reason = \"\";\n    helper.stderr.on(\"data\", (chunk) => { reason += chunk; });\n    helper.on(\"error\", (error) => done({ block: true, reason: String(error) }));\n    helper.on(\"close\", (code) => done(code === 0 ? undefined\n      : { block: true, reason: reason.trim() || \"the owner's rules could not be checked\" }));\n    helper.stdin.end(JSON.stringify({ tool_name: event.toolName, tool_input: event.input }));\n  }) : undefined);\n}\n",
      "argv": [
        "--no-extensions",
        "-e",
        "builtin:mcp",
        "-e",
        "{system}/decide.mjs"
      ],
      "runs": {
        "exec": true
      },
      "kinds": {
        "shell": [
          "bash"
        ],
        "file_write": [
          "write",
          "edit"
        ]
      },
      "mcp": {
        "prefix": "mcp__",
        "join": "__"
      },
      "fails": "closed",
      "cite": "https://unpkg.com/@earendil-works/pi-coding-agent@1.4.0/docs/extensions.md",
      "read": "2026-11-21"
    },
    "tools": {
      "allow": {
        "argv": [
          "--tools",
          "{tools}"
        ],
        "join": ","
      }
    },
    "unattended_argv": [
      "--approve"
    ],
    "home_env": {
      "PI_CODING_AGENT_DIR": "{home}/.pi/agent"
    },
    "files": {
      "{home}/.pi/agent/models.json": "{\"providers\": {\"{provider}\": {\"baseUrl\": \"{base_url}\"}}}"
    },
    "no_update": {
      "env": {
        "PI_SKIP_VERSION_CHECK": "1"
      }
    },
    "secret_paths": [
      "{home}/.pi/agent/auth.json",
      "{home}/.pi/agent/mcp-auth.json"
    ],
    "session_paths": [
      "{home}/.pi/agent/sessions/"
    ],
    "hosts": {
      "registry": [
        "registry.npmjs.org"
      ],
      "login": [],
      "provider": []
    }
  }
}
