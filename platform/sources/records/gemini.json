{
  "id": "gemini",
  "display_name": "Gemini",
  "connect": [
    "cli"
  ],
  "cli": {
    "install": {
      "manager": "npm",
      "lock_sha256": "cbc217f75509077138f3a0d9127c959c71a271ba13c9cecb19628a27efd8f2e0",
      "package": "@google/gemini-cli",
      "version": "0.66.0",
      "integrity": "sha512-EAtsJ9/JxiphHlduzvhoCkb7I0LdOxyugB5NpUtVqKVGZIWjV3JmurvK89ZrvMbV3kwk5SdWINz1M5ZN/2K/Lw==",
      "bin": "gemini",
      "verify_argv": [
        "{bin}",
        "--version"
      ],
      "lifecycle_scripts": true
    },
    "credential": [
      "vendor_login_in_sandbox",
      "api_key"
    ],
    "login": {
      "argv": [
        "{bin}"
      ],
      "url_pattern": "(https://accounts\\.google\\.com/[^\\s\\u001b]+)",
      "accepts_code": true,
      "state_checks": [
        {
          "path": "{home}/.gemini/oauth_creds.json",
          "present": [
            "access_token",
            "refresh_token"
          ]
        }
      ],
      "complete_on_state": true,
      "url": {
        "hosts": [
          "accounts.google.com"
        ],
        "path": "/o/oauth2/v2/auth",
        "params": {
          "redirect_uri": "https://codeassist.google.com/authcode",
          "access_type": "offline",
          "scope": "https://www.googleapis.com/auth/cloud-platform https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile",
          "code_challenge_method": "S256",
          "response_type": "code",
          "client_id": "681255809395-oo8ft2oprdrnp9e3aqf6av3hmdib135j.apps.googleusercontent.com"
        },
        "free": [
          "code_challenge",
          "state"
        ]
      },
      "expires": {
        "s": 300,
        "citation": "@google/gemini-cli 0.66.0 bundle/chunk-HJ5KJXNZ.js authWithUserCode: Authorization timed out after 5 minutes (setTimeout 3e5), read 2026-11-03"
      },
      "hosted_use": {
        "verdict": "unclear",
        "citation": "gemini-cli docs/resources/tos-privacy.md: third-party software using Gemini CLI OAuth to reach its services is a violation; a platform hosting the unmodified CLI for the user's own sign-in is not addressed (subscription-engines.md section 11)"
      },
      "model": {
        "id": "gemini-3.1-pro-preview",
        "citation": "the pinned @google/gemini-cli 0.66.0 bundle's resolveModel (read 2026-11-21): the default auto resolves to gemini-3.1-pro-preview where Gemini 3.1 is launched and the account has preview access, else gemini-3-pro-preview or gemini-2.5-pro; an explicit gemini-3.1-pro-preview without preview access resolves to gemini-2.5-pro, silently (strongest-plan.md)"
      }
    },
    "api_key_env": {
      "google": {
        "base_url": "GOOGLE_GEMINI_BASE_URL",
        "api_key": "GEMINI_API_KEY",
        "base": "connection"
      }
    },
    "unattended": {
      "vendor_login_in_sandbox": {
        "allowed": false,
        "reason": "Unclear: Google's Gemini CLI terms do not say whether a platform may run the unmodified CLI unattended on a member's own Google sign-in, and no Google page read permits it (subscription-engines \u00a73, \u00a711).",
        "cite": "https://github.com/google-gemini/gemini-cli/blob/main/docs/resources/tos-privacy.md",
        "read": "2026-11-01"
      },
      "api_key": {
        "allowed": true,
        "cite": "https://github.com/google-gemini/gemini-cli/blob/main/docs/get-started/authentication.mdx",
        "read": "2026-11-01"
      }
    },
    "per_credential": {
      "vendor_login_in_sandbox": {
        "files": {
          "{home}/.gemini/settings.json": "{\"security\": {\"auth\": {\"selectedType\": \"oauth-personal\", \"enforcedType\": \"oauth-personal\"}}}"
        },
        "forbid_env": [
          "GEMINI_API_KEY",
          "GOOGLE_API_KEY",
          "GOOGLE_GEMINI_BASE_URL",
          "GOOGLE_BASE_URL",
          "GOOGLE_GENAI_USE_VERTEXAI",
          "GEMINI_CLI_USE_COMPUTE_ADC",
          "CODE_ASSIST_ENDPOINT",
          "GOOGLE_GENAI_USE_GCA",
          "GOOGLE_CLOUD_ACCESS_TOKEN",
          "GOOGLE_APPLICATION_CREDENTIALS",
          "GOOGLE_VERTEX_BASE_URL",
          "GEMINI_CLI_AUTH_OVERRIDE",
          "GEMINI_DEFAULT_AUTH_TYPE"
        ]
      },
      "api_key": {
        "files": {
          "{home}/.gemini/settings.json": "{\"security\": {\"auth\": {\"selectedType\": \"gemini-api-key\", \"enforcedType\": \"gemini-api-key\"}}}"
        }
      }
    },
    "engine": {
      "argv": [
        "{bin}",
        "--output-format",
        "stream-json"
      ],
      "resume_argv": [
        "{bin}",
        "--output-format",
        "stream-json",
        "--resume",
        "{sid}"
      ],
      "stdin": "{prompt}",
      "model_argv": [
        "--model",
        "{model}"
      ],
      "events": {
        "format": "jsonl",
        "session_id": [
          {
            "match": {
              "type": "init"
            },
            "path": "session_id"
          }
        ],
        "final_text": [
          {
            "match": {
              "type": "message",
              "role": "assistant"
            },
            "path": "content",
            "accumulate": true
          }
        ],
        "error": [
          {
            "match": {
              "type": "error",
              "severity": "error"
            },
            "path": "message"
          },
          {
            "match": {
              "type": "result",
              "status": "error"
            },
            "path": "error"
          }
        ],
        "usage": [
          {
            "match": {
              "type": "result"
            },
            "path": "stats"
          }
        ],
        "tool_call": [
          {
            "match": {
              "type": "tool_use"
            },
            "path": ""
          }
        ],
        "deferred": [],
        "vendor_limit": [
          {
            "match": {
              "type": "result",
              "status": "error",
              "error.type": "TerminalQuotaError"
            },
            "path": ""
          },
          {
            "match": {
              "type": "result",
              "status": "error",
              "error.type": "RetryableQuotaError"
            },
            "path": ""
          }
        ],
        "retry": []
      }
    },
    "definition": {
      "instructions": {
        "file": "AGENTS.md",
        "shadowed_by": [],
        "setting": "{system}/gemini-settings.json"
      },
      "skills": {
        "paths": [
          ".agents/skills"
        ]
      },
      "native": {
        "refuses": [
          ".gemini/settings.json",
          ".gemini/skills",
          ".gemini/commands",
          ".gemini/agents"
        ],
        "cite": "https://github.com/google-gemini/gemini-cli/blob/v0.66.0/packages/core/src/config/storage.ts",
        "read": "2026-11-22"
      },
      "hooks": {
        "events": {
          "pre_tool": "BeforeTool",
          "post_tool": "AfterTool",
          "prompt": "BeforeAgent",
          "session_start": "SessionStart",
          "stop": "AfterAgent",
          "session_end": "SessionEnd",
          "pre_compact": "PreCompress"
        },
        "file": "{system}/gemini-settings.json",
        "template": "{\"hooksConfig\": {\"enabled\": true}}",
        "each": "{\"hooks\": {\"{native}\": [{\"hooks\": [{\"name\": \"tinyassets-hooks-{event}\", \"type\": \"command\", \"command\": \"{dispatcher} {event}\", \"timeout\": 600000}]}]}}",
        "runs": {"shell": ["bash", "-c"]},
        "fails": "open",
        "cite": "https://github.com/google-gemini/gemini-cli/blob/v0.66.0/docs/hooks/reference.md",
        "read": "2026-11-21"
      }
    },
    "mcp": {
      "file": "{system}/gemini-settings.json",
      "template": "{\"context\": {\"fileName\": [\"AGENTS.md\"]}, \"telemetry\": {\"enabled\": false}, \"general\": {\"disableAutoUpdate\": true, \"sessionRetention\": {\"enabled\": false}}, \"security\": {\"folderTrust\": {\"enabled\": false}}}",
      "servers": "mcpServers",
      "names": "mcp.allowed",
      "http": {
        "httpUrl": "{url}"
      },
      "stdio": {
        "command": "{command}",
        "args": "{args}",
        "env": "{env}"
      },
      "argv": [],
      "argv_each": [
        "--allowed-mcp-server-names={name}"
      ],
      "trust": "Every server is in the system settings, outside the agent's folder, and only they load: mcp.allowed and --allowed-mcp-server-names name each, and the argv's list replaces every settings layer's (packages/cli/src/config/config.ts)."
    },
    "decide": {
      "file": "{system}/gemini-settings.json",
      "template": "{\"advanced\": {\"ignoreLocalEnv\": true}, \"hooks\": {\"BeforeTool\": [{\"matcher\": \"{matcher}\", \"hooks\": [{\"name\": \"tinyassets-decide\", \"type\": \"command\", \"command\": \"{decide}\", \"timeout\": 60000}]}]}, \"hooksConfig\": {\"enabled\": true}}",
      "runs": {
        "shell": [
          "bash",
          "-c"
        ]
      },
      "kinds": {
        "shell": [
          "run_shell_command"
        ],
        "file_write": [
          "write_file",
          "replace"
        ]
      },
      "mcp": {
        "prefix": "mcp_",
        "join": "_"
      },
      "fails": "open",
      "cite": "https://github.com/google-gemini/gemini-cli/blob/v0.66.0/packages/core/src/hooks/hookRunner.ts",
      "read": "2026-11-21"
    },
    "tools": {
      "allow": {
        "file": "{system}/gemini-settings.json",
        "key": "tools.core"
      },
      "deny": {
        "file": "{system}/gemini-settings.json",
        "key": "tools.exclude"
      }
    },
    "unattended_argv": [
      "--approval-mode",
      "yolo"
    ],
    "home_env": {
      "GEMINI_CLI_HOME": "{home}"
    },
    "env": {
      "NO_BROWSER": "true",
      "GEMINI_CLI_SYSTEM_SETTINGS_PATH": "{system}/gemini-settings.json"
    },
    "no_update": {
      "file": "{system}/gemini-settings.json"
    },
    "secret_paths": [
      "{home}/.gemini/oauth_creds.json",
      "{home}/.gemini/mcp-oauth-tokens.json",
      "{home}/.gemini/a2a-oauth-tokens.json",
      "{home}/.gemini/gemini-credentials.json"
    ],
    "session_paths": [
      "{home}/.gemini/tmp/*/chats/"
    ],
    "resume_paths": [
      "{home}/.gemini/tmp/*/chats/"
    ],
    "hosts": {
      "registry": [
        "registry.npmjs.org"
      ],
      "login": [
        "accounts.google.com",
        "oauth2.googleapis.com",
        "www.googleapis.com",
        "cloudcode-pa.googleapis.com",
        "codeassist.google.com"
      ],
      "provider": [
        "oauth2.googleapis.com",
        "www.googleapis.com",
        "cloudcode-pa.googleapis.com"
      ]
    }
  }
}
