{
  "id": "openrouter_user_models_v1",
  "display_name": "OpenRouter",
  "suggested": true,
  "help_url": "https://openrouter.ai/settings/keys",
  "connect": [
    "oauth",
    "api_key"
  ],
  "provider": "openrouter",
  "api": "openai-completions",
  "base_url": "https://openrouter.ai/api/v1",
  "auth": {
    "header": "authorization",
    "scheme": "Bearer"
  },
  "verify_url": "https://openrouter.ai/api/v1/models/user",
  "endpoints": [
    {
      "origin": "https://openrouter.ai",
      "paths": [
        "/api/v1/chat/completions"
      ],
      "methods": [
        "POST"
      ]
    },
    {
      "origin": "https://openrouter.ai",
      "paths": [
        "/api/v1/models/user",
        "/api/v1/benchmarks",
        "/api/v1/key"
      ],
      "methods": [
        "GET"
      ]
    }
  ],
  "engines": [
    "pi"
  ],
  "not_interactive": [
    "*:batch"
  ],
  "credit": {
    "url": "https://openrouter.ai/api/v1/key",
    "none_when": [
      {
        "path": [
          "data",
          "is_free_tier"
        ],
        "equals": true
      },
      {
        "path": [
          "data",
          "limit_remaining"
        ],
        "at_most": 0
      }
    ],
    "refused": [
      402
    ],
    "free": [
      "*:free"
    ],
    "cite": "https://openrouter.ai/docs/api_reference/limits"
  },
  "routers": [
    {
      "models": [
        "openrouter/free"
      ],
      "to": [
        "*:free"
      ],
      "cite": "https://openrouter.ai/openrouter/free"
    },
    {
      "models": [
        "auto",
        "openrouter/auto",
        "openrouter/auto-beta"
      ],
      "to": [
        "*"
      ],
      "cite": "https://openrouter.ai/docs/guides/routing/routers/auto-router"
    },
    {
      "models": [
        "openrouter/pareto-code"
      ],
      "to": [
        "*"
      ],
      "cite": "https://openrouter.ai/docs/guides/routing/routers/pareto-router"
    }
  ],
  "oauth": {
    "protocol": "pkce_user_key_v1",
    "authorization_endpoint": "https://openrouter.ai/auth",
    "exchange_endpoint": "https://openrouter.ai/api/v1/auth/keys",
    "authorize_params": {
      "key_label": "TinyAssets"
    }
  }
}
