{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["owner/src/**/*.ts", "owner/test/**/*.ts", "owner/guards/**/*.ts", "owner/*.ts",
              "files/src/**/*.ts", "files/test/**/*.ts", "files/guards/**/*.ts", "files/*.ts",
              "doors/src/**/*.ts", "doors/test/**/*.ts", "doors/guards/**/*.ts", "doors/*.ts",
              "gateway/src/**/*.ts", "gateway/test/**/*.ts", "gateway/guards/**/*.ts",
              "gateway/*.ts"]
}
