// The per-owner Durable Object (ADR-032). Not deployed yet: no workflow deploys
// platform/. Edge Workers bind OWNER to this class by script_name from their own
// configs. This Worker binds three things: the FILES service, the files Worker, which
// itself binds no Durable Object and no service; the GATEWAY service, the model gateway,
// which binds nothing at all, so neither is a way to another owner's object; and PISTORE,
// the namespace of its own second class, ThreadStore (one pi store per agent thread, no
// script_name), whose objects are named only by random ids the owner object's rows hold
// and reach nothing (ADR-032 §1, amended 2026-10-30). `disable_ctx_exports` keeps the
// runtime from handing the object its own namespaces as `ctx.exports`
// (guards/config.test.ts checks this config and the files Worker's).
// `limits.subrequests` is the platform's per-invocation count of the calls the object
// makes (FILES, the gateway, every thread store RPC), charged to its newest incoming event
// or to a count each event resets (cap-probe M12, newest-or-reset); the platform's own
// error is the loud failure, and the object keeps no budget of its own. One alarm-tracked
// wait of up to 10 minutes can carry every store, gateway and files call of every thread
// it covers (about 10,000 at 16 streaming threads with 1 s partial commits), so it is set
// well above the 10,000 Paid default, within Paid's 10,000,000, until live probe P4
// measures a real run's count; pinned by the config guard.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tinyassets-owner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "disable_ctx_exports"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "subrequests": 1000000 },
  "services": [
    { "binding": "FILES", "service": "tinyassets-files" },
    { "binding": "GATEWAY", "service": "tinyassets-gateway" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PISTORE", "class_name": "ThreadStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OwnerDO", "ThreadStore"] }
  ]
}
