// The per-owner Durable Object (ADR-032, amended by ADR-034). Not deployed yet: no
// workflow deploys platform/. Edge Workers bind OWNER to this class by script_name from
// their own configs. This Worker binds three things: the FILES service, the files Worker,
// which itself binds no Durable Object and no service; the GATEWAY service, the model
// gateway, which binds nothing at all; and the HOOKS service, the hooks Worker, which
// binds only its own class, where code mode's VMs run; so none is a way to another
// owner's object. It binds no Durable Object namespace. Its one store is CONTROL, the
// platform's control record alone (the doors' namespace of it, the same placeholder id),
// which code mode's calls read for the gates the door read; it holds no owner's state. `disable_ctx_exports` keeps the
// runtime from handing the object its own namespaces as `ctx.exports`
// (guards/config.test.ts checks this config and the files Worker's).
// `limits.subrequests` is the platform's per-invocation count of the calls the object
// makes (FILES and the gateway as subrequests), reset as the work moves across events
// (live probe P1, `store-probe.md`: at 10,000, calls stopped at exactly 10,000 in one
// alarm; at 1,000,000 they passed); the platform's own error is the loud failure, and the
// object keeps no budget of its own. Paid accepts 1,000,000 (P1), within its 10,000,000;
// pinned by the config guard. Its one secret, ROUTING_MAC_KEY (32 random bytes, base64url, generated
// at deploy and set in the doors Worker too), is the key the sandbox tokens are MAC'd
// under (doors/src/routing-mac.ts); `secrets.required` makes a deploy without it fail.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tinyassets-owner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "disable_ctx_exports"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "subrequests": 1000000 },
  "secrets": { "required": ["ROUTING_MAC_KEY"] },
  "kv_namespaces": [
    { "binding": "CONTROL", "id": "not-provisioned-control" }
  ],
  "services": [
    { "binding": "FILES", "service": "tinyassets-files" },
    { "binding": "GATEWAY", "service": "tinyassets-gateway" },
    { "binding": "HOOKS", "service": "tinyassets-hooks" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OwnerDO"] }
  ]
}
