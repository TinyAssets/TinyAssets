// The hooks Worker (ADR-032 §4; pi audit F8; narrowed to code mode by ADR-034 decision 12):
// code mode's VMs, each execution in its own `CodemodeSandbox`. Not deployed: no workflow
// deploys platform/. It binds the namespace of its own class (no `script_name`), and
// nothing else: no `OWNER`, no bucket, no other service, no Worker Loader, so no script
// reaches an owner's object, ledger or policy. It serves no URL (no route, no workers.dev
// or preview URL): only the owner Worker's `HOOKS` service binding reaches it
// (guards/config.test.ts).
// - compatibility_date: the owner Worker's.
// - disable_ctx_exports: no way to the Worker's own namespaces but its bindings.
// - limits.cpu_ms: room above code mode's interrupt budget (about 10 s of a tight loop),
//   since a script that reaches it resets the object instead of failing alone.
// The class is SQLite-backed and never uses its storage.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tinyassets-hooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["disable_ctx_exports"],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 30000 },
  "durable_objects": {
    "bindings": [
      { "name": "CODEMODE", "class_name": "CodemodeSandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CodemodeSandbox"] }
  ]
}
