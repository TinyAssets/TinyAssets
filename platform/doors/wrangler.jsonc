// The doors Worker: the binder, our OAuth authorization server, the stateless MCP door,
// `/api` keys, `/hooks/inbound` and the owner surface (ADR-032 Decision 2). Not deployable
// as checked in: no routes, no workers.dev or preview URL, its KV namespaces placeholders
// and its sign-in unconfigured, so a deploy cannot succeed; the deploy kit
// (platform/deploy/deploy.ts) writes the deployed config from this one, filling only the
// namespace ids, the routes and the upstream's values. It binds exactly what
// guards/config.test.ts allows:
// - OWNER: the owner Worker's namespace, by script_name. Only src/binder.ts reaches it.
// - GATEWAY: the model gateway's ConnectGateway entrypoint, which serves only the connect
//   steps (seal, exchange, verify): no model call, no egress forwarding, and the keyring
//   stays in the gateway. Only src/connect.ts reaches it.
// - EGRESS: the model gateway's EgressGateway entrypoint, which serves only forward: the
//   egress door streams a sandbox request the owner's object admitted through it. Only
//   src/egress.ts reaches it.
// - OAUTH_KV: the OAuth provider's own store; DIRECTORY: the owner directory (routing
//   hints); CONTROL: the platform's control record alone, which the owner Worker binds too
//   (code mode's calls read the gates again). Three namespaces, so their schemas never
//   collide, and the owner's object reaches no directory entry.
// - FILES: the files Worker's FilesUpload entrypoint, which serves putChunks alone, what the
//   file door's bytes call (the binder streams an upload's chunks to it, src/file-bytes.ts):
//   the doors hold an uploading owner's wrapped data key, so they bind no read and no key
//   call of the files Worker's (review M5-1). Only src/file-bytes.ts reaches it.
// - No ratelimits: no number of ours bounds any caller (slice L's review). Cloudflare's own
//   DDoS protection is in front of every Worker; a metadata fetch the OAuth provider makes
//   is bounded by the provider (public URLs, 5 KiB, 10 s; global_fetch_strictly_public).
// - queues: also the consumer of the erasure queue (slice L, src/erase.ts), whose one
//   producer is the owner Worker: {owner}, the erasure's outside record.
// - DCR_ENABLED: dynamic registration for the vendors that offer no CIMD (the founder's
//   ruling, 2026-11-04), off until the doors go live (mode `routes`); on, it takes only a client
//   named for such a vendor whose every redirect is that vendor's (apps.json). OWNER_ISSUER:
//   AuthKit's issuer, whose subjects stay owner ids; until the deploy sets it, every
//   sign-in fails loudly. FOREIGN_ISSUERS: the other issuers whose owners are
//   namespaced, each listed by its own slice; none today, and any unlisted issuer fails.
//   UPSTREAM: the owner issuer's endpoints and our client at it (src/oidc.ts), filled by
//   the deploy from the issuer's live discovery once its issuer is OWNER_ISSUER exactly.
// - queues: the consumer of the sandbox line's ring queue (slice S, src/ring.ts), which
//   turns {owner} into that owner's sandboxRung (its waiting runs start again) and nothing
//   else; the sandbox Worker is its one producer.
// - ROUTING_MAC_KEY: the key sandbox tokens are MAC'd under (32 random
//   bytes, base64url, generated at deploy and set in the owner Worker too); the egress
//   door verifies a token by it before any stub call (contract/src/routing-mac.ts).
//   WORKOS_API_KEY: the upstream's client secret (the code exchange, the identity's deletion
//   at an erasure), set by the deploy kit from the production environment's secrets.
//   E2B_WEBHOOK_SECRET: the signature secret of E2B's sandbox lifecycle webhook
//   (src/e2b-hooks.ts, `/hooks/e2b/lifecycle`), set and registered with E2B by the deploy kit.
//   `secrets.required` makes a deploy without any of the three fail. A shared inbound app's
//   signing secret (shared-apps.json names it, INBOUND_SLACK_SIGNING_SECRET) is set when the
//   app is; without it that app's door refuses loudly.
// `global_fetch_strictly_public` is required for Client ID Metadata Documents: the
// provider fetches a client's metadata URL, and the flag keeps that fetch off same-zone
// routing (its SSRF protection); without it the provider will not advertise CIMD.
// - ASSETS: the owner app's own files (`app/`: its pages, script and style), Workers Static
//   Assets, served only through src/pages.ts (`run_worker_first`), which names each page and
//   sets its security headers; no file is served past the Worker. The app sits on the same
//   origin as `/app/api`, so its session cookie and CSP hold (tasks 2, the owner app).
// `enable_request_signal` fires a request's `signal` when its client disconnects, so the
// egress door settles a call whose client left before the answer at once.
// - The cutover's import window (src/import/), deleted at the cutover with platform/import/:
//   IMPORT_STAGING, the staging bucket the importer's job writes each owner's bundle to; the
//   import queue's producer (IMPORTS), by which its consumer sends its own continuation; and
//   that consumer, one message a batch, four owners at once, its dead-letter queue the one
//   the job reads. Its key, IMPORT_KEY, is set only for the window, so it is not required:
//   without it every import message is dropped.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tinyassets-doors",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "disable_ctx_exports", "global_fetch_strictly_public",
                          "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "DCR_ENABLED": "false", "OWNER_ISSUER": "not-configured", "FOREIGN_ISSUERS": "[]",
            "UPSTREAM": "not-configured" },
  "secrets": { "required": ["ROUTING_MAC_KEY", "WORKOS_API_KEY", "E2B_WEBHOOK_SECRET"] },
  "durable_objects": {
    "bindings": [
      { "name": "OWNER", "class_name": "OwnerDO", "script_name": "tinyassets-owner" }
    ]
  },
  "services": [
    { "binding": "GATEWAY", "service": "tinyassets-gateway", "entrypoint": "ConnectGateway" },
    { "binding": "EGRESS", "service": "tinyassets-gateway", "entrypoint": "EgressGateway" },
    { "binding": "FILES", "service": "tinyassets-files", "entrypoint": "FilesUpload" }
  ],
  "assets": { "directory": "./app", "binding": "ASSETS", "run_worker_first": true,
              "html_handling": "none", "not_found_handling": "none" },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "not-provisioned-oauth" },
    { "binding": "DIRECTORY", "id": "not-provisioned-directory" },
    { "binding": "CONTROL", "id": "not-provisioned-control" }
  ],
  "r2_buckets": [
    { "binding": "IMPORT_STAGING", "bucket_name": "tinyassets-import-staging" }
  ],
  "queues": {
    "producers": [
      { "binding": "IMPORTS", "queue": "tinyassets-import" }
    ],
    "consumers": [
      { "queue": "tinyassets-sandbox-ring" },
      { "queue": "tinyassets-erasure" },
      { "queue": "tinyassets-import", "max_batch_size": 1, "max_concurrency": 4,
        "dead_letter_queue": "tinyassets-import-dlq" }
    ]
  }
}
